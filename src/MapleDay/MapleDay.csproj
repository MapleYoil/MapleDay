<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>MapleDay</RootNamespace>
    <Version>1.1.10.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Branding\mapleday.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\artifacts\MapleDay\App\</PublishDir>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyTitle>메요일</AssemblyTitle>
    <Product>MapleDay</Product>
    <Company>MapleYoil</Company>
    <Authors>MapleYoil</Authors>
    <Description>메이플스토리 캐릭터 목록 유틸리티</Description>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="..\..\LICENSE;..\..\THIRD_PARTY_NOTICES.md">
      <Link>%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <EmbeddedResource Include="..\..\docs\privacy-policy.txt" LogicalName="MapleDay.PrivacyPolicy.txt" />
    <EmbeddedResource Include="..\..\artifacts\build\market-client.pem" LogicalName="MapleDay.MarketClient.pem" Condition="Exists('..\..\artifacts\build\market-client.pem')" />
    <Content Include="Assets\Decoded\**\*.bgra;Assets\Decoded\manifest.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.12" />
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.9169" />
    <ProjectReference Include="..\MapleDay.Core\MapleDay.Core.csproj" />
    <ProjectReference Include="..\MapleDay.Web\MapleDay.Web.csproj" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Content Include="Assets\Worlds\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Assets\Scheduler\**\*.png;Assets\Scheduler\**\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Assets\Branding\*.png;Assets\Branding\*.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Assets\IncomeReplay\**\*.png;Assets\IncomeReplay\**\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Assets\BossLoot\*.png;Assets\BossLoot\manifest.json;Assets\Hunting\*.png;Assets\Hunting\manifest.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Assets\Fonts\*.ttf;Assets\Fonts\LICENSE.txt;Assets\Licenses\*.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
  <Target Name="IncludeWinUIResourcesInPublish" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <_WinUIResourcesToPublish Include="$(TargetDir)**\*.xbf;$(TargetDir)$(AssemblyName).pri" />
      <ResolvedFileToPublish Include="@(_WinUIResourcesToPublish)">
        <RelativePath>%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
