            <StackPanel Padding="24,28" Spacing="20" MaxWidth="980" HorizontalAlignment="Stretch">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="NotificationsTitle" Text="알림" FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Button x:Name="ClearRemindersButton" Grid.Column="1" Content="모두 비우기" Click="ClearRemindersButton_Click" IsEnabled="False" VerticalAlignment="Center" AutomationProperties.Name="알림 목록 모두 비우기" />
                    <Button x:Name="NotificationSettingsButton" Grid.Column="2" Click="NotificationSettingsButton_Click" VerticalAlignment="Center" AutomationProperties.Name="알림 설정 열기">
                        <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE713;" FontSize="16"/><TextBlock Text="설정"/></StackPanel>
                    </Button>
                    <Button x:Name="NotificationListButton" Grid.Column="1" Grid.ColumnSpan="2" Content="알림으로 돌아가기" Click="NotificationListButton_Click" Visibility="Collapsed"/>
                </Grid>
                <InfoBar x:Name="ReminderMessage" IsOpen="False" />
                <StackPanel x:Name="NotificationSettingsPanel" Visibility="Collapsed" Spacing="20">
                    <Border Padding="24" CornerRadius="16" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                        <StackPanel Spacing="16">
                            <ToggleSwitch x:Name="AllRemindersToggle" Header="전체 알림" OnContent="켜짐" OffContent="꺼짐" Toggled="ReminderToggle_Toggled" />
                            <ToggleSwitch x:Name="StartupRemindersToggle" Header="앱 실행 시 바로 알림" OnContent="켜짐" OffContent="꺼짐" Toggled="ReminderToggle_Toggled" />
                            <TextBlock Text="켜두면 앱을 새로 시작할 때 미완료 항목을 확인해 한 번 알립니다. 전체·종류별 알림 설정을 따르며, 변경은 다음 실행부터 적용됩니다." Style="{StaticResource SecondaryText}" TextWrapping="Wrap" />
                            <TextBlock x:Name="ReminderRuntimeStatus" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" />
                            <Button Content="Windows 알림 다시 연결" Click="ReconnectNotifications_Click" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>
                    <Border Padding="24" CornerRadius="16" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                        <StackPanel Spacing="12">
                            <ToggleSwitch x:Name="DailyReminderToggle" Header="일일 퀘스트" OnContent="켜짐" OffContent="꺼짐" Toggled="ReminderToggle_Toggled" />
                            <TextBlock Text="매일 00:00 초기화 · 한국 시간" Style="{StaticResource SecondaryText}" />
                            <NumberBox x:Name="DailyReminderHours" Header="초기화 몇 시간 전에 알릴까요?" Minimum="1" Maximum="23" SmallChange="1" LargeChange="1" SpinButtonPlacementMode="Inline" ValueChanged="ReminderHours_ValueChanged" Width="260" HorizontalAlignment="Left" />
                            <TextBlock x:Name="DailyReminderNext" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border Padding="24" CornerRadius="16" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                        <StackPanel Spacing="12">
                            <ToggleSwitch x:Name="WeeklyQuestReminderToggle" Header="주간 퀘스트" OnContent="켜짐" OffContent="꺼짐" Toggled="ReminderToggle_Toggled" />
                            <ToggleSwitch x:Name="UnionQuestReminderToggle" Header="메이플 유니온 퀘스트 알림" OnContent="켜짐" OffContent="꺼짐" Toggled="ReminderToggle_Toggled" />
                            <TextBlock Text="목요일 00:00 초기화 · 한국 시간" Style="{StaticResource SecondaryText}" />
                            <NumberBox x:Name="WeeklyQuestReminderHours" Header="초기화 몇 시간 전에 알릴까요?" Minimum="1" Maximum="167" SmallChange="1" LargeChange="1" SpinButtonPlacementMode="Inline" ValueChanged="ReminderHours_ValueChanged" Width="260" HorizontalAlignment="Left" />
                            <TextBlock x:Name="WeeklyQuestReminderNext" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border Padding="24" CornerRadius="16" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                        <StackPanel Spacing="12">
                            <ToggleSwitch x:Name="WeeklyBossReminderToggle" Header="주간 보스" OnContent="켜짐" OffContent="꺼짐" Toggled="ReminderToggle_Toggled" />
                            <TextBlock Text="목요일 00:00 초기화 · 한국 시간" Style="{StaticResource SecondaryText}" />
                            <NumberBox x:Name="WeeklyBossReminderHours" Header="초기화 몇 시간 전에 알릴까요?" Minimum="1" Maximum="167" SmallChange="1" LargeChange="1" SpinButtonPlacementMode="Inline" ValueChanged="ReminderHours_ValueChanged" Width="260" HorizontalAlignment="Left" />
                            <TextBlock x:Name="WeeklyBossReminderNext" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    
                </StackPanel>
                <StackPanel x:Name="NotificationListPanel" Spacing="20">
                    <TextBlock x:Name="ReminderEmpty" Text="아직 받은 알림이 없어요." Style="{StaticResource SecondaryText}" />
                    <ItemsControl ItemsSource="{x:Bind ReminderNotices}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:ReminderCard">
                                <Border Padding="20" Margin="0,0,0,12" CornerRadius="16" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Opacity="{x:Bind Opacity}">
                                    <StackPanel Spacing="10">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind Title}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
                                            <Button Grid.Column="1" Content="삭제" Tag="{x:Bind Id}" Click="DeleteReminderButton_Click" MinHeight="30" Padding="10,4" FontSize="12" VerticalAlignment="Top" AutomationProperties.Name="{x:Bind DeleteAccessibleName}" />
                                        </Grid>
                                        <TextBlock Text="{x:Bind CreatedText}" Style="{StaticResource SecondaryText}" FontSize="12" />
                                        <TextBlock Text="{x:Bind Summary}" TextWrapping="Wrap" />
                                        <ItemsControl ItemsSource="{x:Bind Contents}" AutomationProperties.Name="콘텐츠별 미완료 목록">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:ReminderContentCard">
                                                    <Border Padding="14" Margin="0,4" CornerRadius="10" Background="{StaticResource StageBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                                                        <StackPanel Spacing="10">
                                                            <Grid ColumnSpacing="10">
                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                                                <Image services:CachedImage.File="{x:Bind IconFile}" Width="25" Height="25" Stretch="None" Visibility="{x:Bind IconVisibility}"/>
                                                                <FontIcon Glyph="{x:Bind Glyph}" FontSize="20" Foreground="{StaticResource AccentBrush}" Visibility="{x:Bind FallbackVisibility}"/>
                                                                <StackPanel Grid.Column="1" Spacing="4">
                                                                    <TextBlock Text="{x:Bind Name}" FontWeight="Medium" TextWrapping="Wrap"/>
                                                                    <TextBlock Text="{x:Bind Count}" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                                                                </StackPanel>
                                                            </Grid>
                                                            <ItemsControl ItemsSource="{x:Bind Characters}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate x:DataType="core:ReminderCharacter">
                                                                        <Grid ColumnSpacing="12" Padding="4,6" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
                                                                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                                            <TextBlock Text="{x:Bind Name}" TextWrapping="Wrap"/>
                                                                            <TextBlock Grid.Column="1" Text="{x:Bind World}" FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                                                                        </Grid>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="24" Spacing="20">
                <TextBlock Text="설정" FontSize="28" FontWeight="SemiBold" />
                <Border Padding="24" CornerRadius="16" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                    <StackPanel Spacing="12">
                        <TextBlock Text="앱 업데이트" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock x:Name="AppVersionText" Style="{StaticResource SecondaryText}" />
                        <ToggleSwitch x:Name="AutomaticUpdatesToggle" Header="새 버전 자동 확인 및 다운로드" Toggled="AutomaticUpdatesToggle_Toggled" />
                        <TextBlock x:Name="UpdateStatusText" Text="업데이트를 확인할 수 있습니다." Style="{StaticResource SecondaryText}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                        <ProgressBar x:Name="UpdateDownloadProgress" Visibility="Collapsed" Minimum="0" Maximum="100" AutomationProperties.Name="업데이트 다운로드 진행도" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="CheckUpdateButton" Content="업데이트 확인" Click="CheckUpdateButton_Click" />
                            <Button x:Name="InstallUpdateButton" Content="업데이트하고 다시 시작" Click="InstallUpdateButton_Click" Visibility="Collapsed" Style="{StaticResource AccentButtonStyle}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Padding="24" CornerRadius="16" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                    <StackPanel Spacing="12">
                        <TextBlock Text="현재 API 키의 대표 캐릭터" FontSize="18" FontWeight="SemiBold" />
                        <ComboBox x:Name="RepresentativeCharacter" ItemsSource="{x:Bind Characters}" DisplayMemberPath="Name"
                                  PlaceholderText="API 키로 캐릭터를 불러와주세요" SelectionChanged="RepresentativeCharacter_SelectionChanged" IsEnabled="False" MinWidth="220" />
                        <TextBlock Text="키마다 따로 저장됩니다. 지정하지 않으면 가장 높은 레벨의 캐릭터를 사용하며, 문의의 기본 캐릭터와 저장된 키 목록에 표시됩니다." Style="{StaticResource SecondaryText}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Padding="24" CornerRadius="16" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                    <StackPanel Spacing="12">
                        <TextBlock Text="시작 페이지" FontSize="18" FontWeight="SemiBold" />
                        <ComboBox x:Name="StartPageSelector" SelectionChanged="StartPageSelector_SelectionChanged" MinWidth="220" AutomationProperties.Name="시작 페이지">
                            <ComboBoxItem Content="내 캐릭터" Tag="characters" /><ComboBoxItem Content="스케줄러" Tag="scheduler" /><ComboBoxItem Content="수익" Tag="income" />
                            <ComboBoxItem Content="레벨" Tag="level" /><ComboBoxItem Content="1:1 문의 / 건의사항" Tag="support" /><ComboBoxItem Content="알림" Tag="notifications" /><ComboBoxItem Content="설정" Tag="settings" /><ComboBoxItem Content="API 키" Tag="key" />
                        </ComboBox>
                    </StackPanel>
                </Border>
                <Border Padding="24" CornerRadius="16" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                    <StackPanel Spacing="12">
                        <TextBlock Text="X로 창을 닫을 때" FontSize="18" FontWeight="SemiBold" />
                        <ComboBox x:Name="CloseBehavior" SelectionChanged="CloseBehavior_SelectionChanged" MinWidth="220">
                            <ComboBoxItem Content="트레이에 최소화" /><ComboBoxItem Content="앱 종료" />
                        </ComboBox>
                    </StackPanel>
                </Border>
                <Border Padding="24" CornerRadius="16" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                    <StackPanel Spacing="12">
                        <ToggleSwitch x:Name="WindowsStartupToggle" Header="Windows 시작 시 자동 실행" OnContent="켜짐" OffContent="꺼짐" Toggled="WindowsStartupToggle_Toggled" />
                        <ComboBox x:Name="WindowsStartupBehavior" Header="자동 실행 시" SelectionChanged="WindowsStartupBehavior_SelectionChanged" MinWidth="220" AutomationProperties.Name="Windows 자동 실행 방식">
                            <ComboBoxItem Content="트레이에 최소화" /><ComboBoxItem Content="창 열기" />
                        </ComboBox>
                        <TextBlock x:Name="WindowsStartupStatus" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Padding="24" CornerRadius="16" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                    <StackPanel Spacing="12">
                        <TextBlock Text="기본 창 크기" FontSize="18" FontWeight="SemiBold" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <NumberBox x:Name="WindowWidthInput" Header="가로 (px)" Minimum="420" Maximum="10000" SmallChange="10" LargeChange="100" SpinButtonPlacementMode="Compact" ValueChanged="WindowSize_ValueChanged" AutomationProperties.Name="기본 창 가로 크기" />
                            <NumberBox x:Name="WindowHeightInput" Grid.Column="1" Header="세로 (px)" Minimum="520" Maximum="10000" SmallChange="10" LargeChange="100" SpinButtonPlacementMode="Compact" ValueChanged="WindowSize_ValueChanged" AutomationProperties.Name="기본 창 세로 크기" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="현재 창 크기로 설정" Click="CurrentWindowSizeButton_Click" />
                            <Button Content="초기화" Click="ResetWindowSizeButton_Click" />
                        </StackPanel>
                        <TextBlock x:Name="WindowSizeStatus" Text="다음 실행부터 적용됩니다. 초기화하면 1200 × 800px로 돌아갑니다." Style="{StaticResource SecondaryText}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Padding="24" CornerRadius="16" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                    <StackPanel Spacing="12">
                        <TextBlock Text="앱 데이터" FontSize="18" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock x:Name="AppDataSize" Text="확인 중…" FontSize="20" VerticalAlignment="Center" />
                            <Button Content="용량 새로고침" Click="AppDataRefreshButton_Click" />
                        </StackPanel>
                        <TextBlock Text="이 PC에 저장된 캐릭터 목록, 스케줄러 기록, API 키와 설정 등의 용량입니다." Style="{StaticResource SecondaryText}" TextWrapping="Wrap" />
                        <Button Content="데이터 삭제" Click="DeleteAppDataButton_Click" Foreground="#C42B1C" Background="#FDE7E9" BorderBrush="#F1B3AD" HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>
                <Border Padding="24" CornerRadius="16" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                    <StackPanel Spacing="12">
                        <TextBlock Text="개인정보처리방침" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="API 키와 캐릭터 정보, 문의·건의사항의 처리 및 보관 기준을 확인할 수 있습니다." Style="{StaticResource SecondaryText}" TextWrapping="Wrap" />
                        <Button Content="개인정보처리방침 보기" Click="PrivacyPolicyButton_Click" />
                    </StackPanel>
                </Border>
                <Border Padding="24" CornerRadius="16" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                    <StackPanel Spacing="12">
                        <TextBlock Text="GitHub" FontSize="18" FontWeight="SemiBold" />
                        <HyperlinkButton Content="https://github.com/MapleYoil/MapleDay"
                                         NavigateUri="https://github.com/MapleYoil/MapleDay"
                                         AutomationProperties.Name="메요일 GitHub 저장소 열기" HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="1" Padding="24,12" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="Data based on NEXON Open API" Style="{StaticResource SecondaryText}" FontSize="12" VerticalAlignment="Center" />
                <Button x:Name="UpdateReadyButton" Grid.Column="1" Visibility="Collapsed" Content="새 버전 준비됨 · 업데이트" Click="UpdateReadyButton_Click" MinHeight="28" FontSize="12" Padding="10,4" />
            </Grid>
        </Border>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
