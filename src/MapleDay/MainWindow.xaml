<Window
    x:Class="MapleDay.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:MapleDay.Models"
    xmlns:core="using:MapleDay.Core"
    xmlns:services="using:MapleDay.Services"
    xmlns:views="using:MapleDay.Views"
    Title="메요일 · MapleDay">
    <Grid x:Name="Root" Background="{StaticResource PageBrush}" RequestedTheme="Light" KeyDown="Root_KeyDown">
        <Grid.Resources>
            <DataTemplate x:Key="CharacterIdentityTemplate" x:DataType="models:CharacterCard">
                <Grid RowSpacing="4" VerticalAlignment="Top">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="120" /><RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Width="108" Height="120" HorizontalAlignment="Center">
                        <Grid.Clip><RectangleGeometry Rect="0,0,108,120" /></Grid.Clip>
                        <Border CornerRadius="12" Background="{StaticResource StageBrush}" />
                        <FontIcon Glyph="&#xE77B;" FontSize="32" Foreground="{StaticResource MutedBrush}" Visibility="{x:Bind PlaceholderVisibility, Mode=OneWay}" />
                        <Image Source="{x:Bind ImageSource, Mode=OneWay}" Stretch="None" Width="{x:Bind ImageWidth, Mode=OneWay}" Height="{x:Bind ImageHeight, Mode=OneWay}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="{x:Bind Name, Mode=OneWay}" />
                        <ProgressRing Width="20" Height="20" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8" IsActive="True" Visibility="{x:Bind LoadingVisibility, Mode=OneWay}" />
                    </Grid>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                        <Image Source="{x:Bind WorldIconSource, Mode=OneWay}" Stretch="None" Width="14" Height="14" VerticalAlignment="Center" Visibility="{x:Bind WorldIconVisibility, Mode=OneWay}" />
                        <TextBlock Text="{x:Bind World, Mode=OneWay}" Style="{StaticResource SecondaryText}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="170" />
                    </StackPanel>
                    <TextBlock Grid.Row="2" Text="{x:Bind Name, Mode=OneWay}" FontWeight="SemiBold" FontSize="18" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="190" />
                    <TextBlock Grid.Row="3" Text="{x:Bind Class, Mode=OneWay}" Style="{StaticResource SecondaryText}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="190" />
                    <TextBlock Grid.Row="4" Text="{x:Bind LevelText, Mode=OneWay}" FontSize="14" Foreground="{StaticResource AccentTextBrush}" HorizontalAlignment="Center" />
                </Grid>
            </DataTemplate>
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBar" Background="{StaticResource PageBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48" /><ColumnDefinition Width="48" />
                <ColumnDefinition Width="*" /><ColumnDefinition x:Name="CaptionInset" Width="144" />
            </Grid.ColumnDefinitions>
            <Button x:Name="BackButton" Width="40" Height="36" Padding="0" Background="Transparent" BorderThickness="0"
                    HorizontalAlignment="Center" VerticalAlignment="Center" IsEnabled="False" Click="BackButton_Click"
                    ToolTipService.ToolTip="뒤로가기 (Alt+←)" AutomationProperties.Name="뒤로가기"
                    AutomationProperties.AutomationId="BackButton">
                <FontIcon Glyph="&#xE72B;" FontSize="14" />
            </Button>
            <ToggleButton x:Name="PaneToggleButton" Grid.Column="1" Width="40" Height="36" Padding="0"
                          Background="Transparent" BorderThickness="0" IsChecked="True" Click="PaneToggleButton_Click"
                          HorizontalAlignment="Center" VerticalAlignment="Center" ToolTipService.ToolTip="메뉴 접기"
                          AutomationProperties.Name="메뉴 접기" AutomationProperties.AutomationId="PaneToggleButton">
                <FontIcon Glyph="&#xE700;" FontSize="16" />
            </ToggleButton>
            <Grid x:Name="TitleDragRegion" Grid.Column="2" Background="Transparent">
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="8" Margin="8,0,0,0">
                    <Image services:CachedImage.File="Branding/logo.png" Width="22" Height="22" Stretch="Uniform" />
                    <TextBlock Text="메요일 · MapleDay" FontSize="13" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Grid>

        <NavigationView x:Name="ShellNavigation" Grid.Row="1" FontFamily="{StaticResource AppFont}" PaneDisplayMode="Left" IsPaneOpen="True"
                        OpenPaneLength="208" CompactPaneLength="48" IsPaneToggleButtonVisible="False"
                        IsBackButtonVisible="Collapsed" IsSettingsVisible="False" AlwaysShowHeader="False"
                        IsTitleBarAutoPaddingEnabled="False" ItemInvoked="ShellNavigation_ItemInvoked"
                        PaneOpened="ShellNavigation_PaneChanged" PaneClosed="ShellNavigation_PaneChanged">
            <NavigationView.Resources>
                <StaticResource x:Key="NavigationViewDefaultPaneBackground" ResourceKey="PageBrush" />
                <StaticResource x:Key="NavigationViewExpandedPaneBackground" ResourceKey="PageBrush" />
                <StaticResource x:Key="NavigationViewContentBackground" ResourceKey="CardBrush" />
            </NavigationView.Resources>
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="CharactersNavigationItem" Content="내 캐릭터" Tag="characters"
                                    AutomationProperties.AutomationId="CharactersNavigationItem">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE77B;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="SchedulerNavigationItem" Content="스케줄러" Tag="scheduler">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE787;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="IncomeNavigationItem" Content="수익" Tag="income" AutomationProperties.AutomationId="IncomeNavigationItem">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE9D2;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="LevelNavigationItem" Content="레벨" Tag="level" AutomationProperties.AutomationId="LevelNavigationItem">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE74A;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="SupportNavigationItem" Content="1:1 문의 / 건의사항" Tag="support">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8F2;" /></NavigationViewItem.Icon>
                    <NavigationViewItem.InfoBadge><InfoBadge x:Name="SupportBadge" Visibility="Collapsed" /></NavigationViewItem.InfoBadge>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NotificationsNavigationItem" Content="알림" Tag="notifications">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE7F4;" /></NavigationViewItem.Icon>
                    <NavigationViewItem.InfoBadge><InfoBadge x:Name="ReminderBadge" Visibility="Collapsed" /></NavigationViewItem.InfoBadge>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="KeyNavigationItem" Content="API 키" Tag="key"
                                    AutomationProperties.AutomationId="KeyNavigationItem">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE192;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="SettingsNavigationItem" Content="설정" Tag="settings">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE713;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>
            <Grid Background="{StaticResource PageBrush}" CornerRadius="12,0,0,0"
                  BorderBrush="{StaticResource LineBrush}" BorderThickness="1,1,0,0">
                <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

        <ScrollViewer x:Name="KeyPage" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
            <Grid Padding="24,48" MinHeight="460" VerticalAlignment="Center">
                <Border MaxWidth="460" Padding="32" CornerRadius="20" Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource LineBrush}" BorderThickness="1" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="24">
                        <StackPanel Spacing="10">
                            <TextBlock Text="내 캐릭터 불러오기" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="넥슨 Open API 키를 입력하면&#x0a;내 계정의 캐릭터를 한눈에 볼 수 있어요."
                                       Style="{StaticResource SecondaryText}" TextWrapping="Wrap" LineHeight="23" />
                        </StackPanel>
                        <StackPanel Spacing="10">
                            <ComboBox x:Name="SavedKeySelector" Header="저장된 API 키" ItemsSource="{x:Bind SavedApiKeys}" DisplayMemberPath="DisplayName"
                                      SelectionChanged="SavedKeySelector_SelectionChanged" HorizontalAlignment="Stretch" Visibility="Collapsed" />
                            <TextBlock Text="API 키" FontSize="14" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <PasswordBox x:Name="ApiKeyInput" PlaceholderText="live_"
                                             MinHeight="40" PasswordRevealMode="Hidden" PasswordChanged="ApiKeyInput_PasswordChanged"
                                             KeyDown="ApiKeyInput_KeyDown" AutomationProperties.AutomationId="ApiKeyInput"
                                             AutomationProperties.Name="넥슨 Open API 키" />
                                <ToggleButton x:Name="RevealKeyButton" Grid.Column="1" Width="44" MinHeight="40"
                                              Checked="RevealKeyButton_Changed" Unchecked="RevealKeyButton_Changed"
                                              AutomationProperties.Name="API 키 표시" ToolTipService.ToolTip="API 키 표시 / 숨기기">
                                    <ToggleButton.Resources>
                                        <StaticResource x:Key="ToggleButtonForeground" ResourceKey="MutedBrush" />
                                        <StaticResource x:Key="ToggleButtonForegroundChecked" ResourceKey="AccentBrush" />
                                        <StaticResource x:Key="ToggleButtonForegroundCheckedPointerOver" ResourceKey="AccentBrush" />
                                        <StaticResource x:Key="ToggleButtonForegroundCheckedPressed" ResourceKey="AccentBrush" />
                                        <StaticResource x:Key="ToggleButtonBackgroundChecked" ResourceKey="AccentSoftBrush" />
                                        <StaticResource x:Key="ToggleButtonBackgroundCheckedPointerOver" ResourceKey="AccentSoftBrush" />
                                        <StaticResource x:Key="ToggleButtonBackgroundCheckedPressed" ResourceKey="AccentSoftBrush" />
                                        <StaticResource x:Key="ToggleButtonBorderBrushChecked" ResourceKey="AccentBrush" />
                                        <StaticResource x:Key="ToggleButtonBorderBrushCheckedPointerOver" ResourceKey="AccentBrush" />
                                        <StaticResource x:Key="ToggleButtonBorderBrushCheckedPressed" ResourceKey="AccentBrush" />
                                    </ToggleButton.Resources>
                                    <FontIcon x:Name="RevealKeyIcon" Glyph="&#xE890;" FontSize="18" />
                                </ToggleButton>
                            </Grid>
                            <TextBlock Text="API 키는 이 PC에 저장됩니다."
                                       Style="{StaticResource SecondaryText}" TextWrapping="Wrap" FontSize="12" LineHeight="20" />
                        </StackPanel>
                        <InfoBar x:Name="KeyError" IsOpen="False" Severity="Error" IsClosable="True" />
                        <Button x:Name="ConnectButton" Content="캐릭터 불러오기" HorizontalAlignment="Stretch"
                                MinHeight="44" Style="{StaticResource AccentButtonStyle}" IsEnabled="False"
                                Click="ConnectButton_Click" AutomationProperties.AutomationId="ConnectButton" />
                        <StackPanel x:Name="KeyLoading" Orientation="Horizontal" Spacing="12" Visibility="Collapsed">
                            <ProgressRing Width="20" Height="20" IsActive="True" />
                            <TextBlock Text="캐릭터 목록을 가져오고 있어요…" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
                        </StackPanel>
                        <HyperlinkButton Content="넥슨에서 API 키 발급하기" NavigateUri="https://openapi.nexon.com/ko/my-application/"
                                         Padding="0" HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>

        <Grid x:Name="CharacterPage" Visibility="Collapsed" Padding="24,24,24,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid ColumnSpacing="16" RowSpacing="12" Margin="0,0,0,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup>
                        <VisualState>
                            <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Target="Toolbar.(Grid.Row)" Value="1" />
                                <Setter Target="Toolbar.(Grid.Column)" Value="0" />
                                <Setter Target="Toolbar.(Grid.ColumnSpan)" Value="2" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState>
                            <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="760" /></VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Target="Toolbar.(Grid.Row)" Value="0" />
                                <Setter Target="Toolbar.(Grid.Column)" Value="1" />
                                <Setter Target="Toolbar.(Grid.ColumnSpan)" Value="1" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <StackPanel Spacing="6">
                    <TextBlock Text="내 캐릭터" FontSize="28" FontWeight="SemiBold" />
                    <TextBlock x:Name="CharacterCount" Style="{StaticResource SecondaryText}" />
                </StackPanel>
                <StackPanel x:Name="Toolbar" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button x:Name="RefreshButton" Click="RefreshButton_Click" MinHeight="44" AutomationProperties.AutomationId="RefreshButton">
                        <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE72C;" FontSize="14" /><TextBlock Text="새로고침" /></StackPanel>
                    </Button>
                    <Button Content="키 변경" Click="ChangeKeyButton_Click" MinHeight="44" AutomationProperties.AutomationId="ChangeKeyButton" />
                </StackPanel>
            </Grid>
            <StackPanel x:Name="CharacterFilterControls" Grid.Row="1" Orientation="Horizontal" Spacing="12" Visibility="Collapsed" Margin="0,0,0,12">
                <ComboBox x:Name="CharacterWorldFilter" ItemsSource="{x:Bind CharacterWorlds}" Width="190" SelectionChanged="CharacterWorldFilter_SelectionChanged" AutomationProperties.Name="캐릭터 서버 필터">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="models:CharacterWorldOption">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Image Source="{x:Bind Icon}" Width="14" Height="14" Stretch="None" Visibility="{x:Bind IconVisibility}" />
                                <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock x:Name="CharacterFilterCount" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
            <InfoBar x:Name="ListMessage" Grid.Row="2" IsOpen="False" IsClosable="True" Severity="Warning" Margin="0,0,0,12" />
            <Grid x:Name="DetailLoading" Grid.Row="3" Visibility="Collapsed" RowSpacing="8" Margin="0,0,0,12">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock x:Name="LoadingText" Style="{StaticResource SecondaryText}" VerticalAlignment="Center"
                           AutomationProperties.LiveSetting="Polite" />
                <Button Grid.Column="1" Content="중단" Click="CancelButton_Click" />
                <ProgressBar x:Name="DetailProgress" Grid.Row="1" Grid.ColumnSpan="2" Height="3" />
            </Grid>
            <Grid Grid.Row="4">
                <GridView x:Name="CharacterGrid" ItemsSource="{x:Bind FilteredCharacters}" SelectionMode="None" IsItemClickEnabled="False"
                          HorizontalAlignment="Stretch" ScrollViewer.HorizontalScrollMode="Disabled"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled" Padding="0,0,0,12"
                          AutomationProperties.Name="내 캐릭터 목록">
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" ItemWidth="296" ItemHeight="320" /></ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                    <GridView.ItemContainerStyle>
                        <Style TargetType="GridViewItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Left" />
                            <Setter Property="VerticalContentAlignment" Value="Top" />
                        </Style>
                    </GridView.ItemContainerStyle>
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="models:CharacterCard">
                            <Border Width="280" Height="304" CornerRadius="18" Background="{StaticResource CardBrush}"
                                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="12,10"
                                    AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}"
                                    ToolTipService.ToolTip="{x:Bind Tooltip, Mode=OneWay}">
                                <Grid RowSpacing="8">
                                    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <ContentControl Content="{x:Bind}" ContentTemplate="{StaticResource CharacterIdentityTemplate}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top" IsTabStop="False" />
                                    <TextBlock Grid.Row="1" Text="{x:Bind UpdatedText, Mode=OneWay}" Style="{StaticResource SecondaryText}" FontSize="11" HorizontalAlignment="Center" />
                                    <Button Grid.Row="2" Content="{x:Bind SchedulerButtonText, Mode=OneWay}" Tag="{x:Bind Ocid}" Click="CharacterAddSchedulerButton_Click"
                                            Style="{StaticResource AccentButtonStyle}"
                                            IsEnabled="{x:Bind CanAddToScheduler, Mode=OneWay}" MinHeight="32" FontSize="12" Padding="12,5"
                                            HorizontalAlignment="Stretch" AutomationProperties.Name="{x:Bind SchedulerButtonAccessibleName, Mode=OneWay}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
                <StackPanel x:Name="EmptyState" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                    <FontIcon Glyph="&#xE8A5;" FontSize="32" Foreground="{StaticResource MutedBrush}" />
                    <TextBlock Text="조회할 캐릭터가 없어요" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="API 키에 연결된 계정과 캐릭터를 확인해주세요."
                               Style="{StaticResource SecondaryText}" TextWrapping="Wrap" TextAlignment="Center" />
                </StackPanel>
                <StackPanel x:Name="ConnectState" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                    <FontIcon Glyph="&#xE77B;" FontSize="32" Foreground="{StaticResource MutedBrush}" />
                    <TextBlock Text="내 캐릭터를 불러와주세요" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="넥슨 Open API 키를 입력하면 캐릭터 목록을 볼 수 있어요."
                               Style="{StaticResource SecondaryText}" TextWrapping="Wrap" TextAlignment="Center" />
                    <Button Content="API 키 입력" Click="OpenKeyPageButton_Click" Style="{StaticResource AccentButtonStyle}"
                            HorizontalAlignment="Center" Margin="0,8,0,0" />
                </StackPanel>
            </Grid>
        </Grid>
        <ScrollViewer x:Name="SupportPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Padding="24" Spacing="20">
                <StackPanel Spacing="6">
                    <TextBlock Text="1:1 문의 / 건의사항" FontSize="28" FontWeight="SemiBold" />
                    <TextBlock Text="문의 답변은 이곳에서 확인할 수 있어요. 건의사항은 운영자에게 전달됩니다."
                               Style="{StaticResource SecondaryText}" TextWrapping="Wrap" />
                </StackPanel>
                <InfoBar x:Name="SupportMessage" IsOpen="False" IsClosable="True" />
                <Border x:Name="SupportLoginPrompt" Padding="20" CornerRadius="12" Background="{StaticResource CardBrush}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="API 키로 로그인하면 캐릭터 닉네임으로 문의를 보낼 수 있어요." TextWrapping="Wrap" />
                        <Button Content="API 키 로그인" Click="OpenKeyPageButton_Click" />
                    </StackPanel>
                </Border>
                <Border x:Name="SupportForm" Padding="24" CornerRadius="16" Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                    <StackPanel Spacing="16">
                        <Grid ColumnSpacing="16" RowSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <ComboBox x:Name="SupportKind" Header="유형" SelectedIndex="0" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="1:1 문의" Tag="inquiry" /><ComboBoxItem Content="건의사항" Tag="suggestion" />
                            </ComboBox>
                            <ComboBox x:Name="SupportCharacter" Grid.Column="1" Header="보내는 캐릭터" ItemsSource="{x:Bind Characters}"
                                      DisplayMemberPath="Name" HorizontalAlignment="Stretch" AutomationProperties.Name="문의하는 캐릭터 선택" />
                        </Grid>
                        <TextBox x:Name="SupportSubject" Header="제목" MaxLength="120" PlaceholderText="제목을 입력해주세요" />
                        <TextBox x:Name="SupportBody" Header="내용" MaxLength="6000" AcceptsReturn="True" TextWrapping="Wrap"
                                 MinHeight="160" MaxHeight="320" PlaceholderText="문의 또는 건의사항을 작성해주세요" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button x:Name="SupportSendButton" Content="보내기" Click="SupportSendButton_Click" MinWidth="100"
                                    Style="{StaticResource AccentButtonStyle}" />
                            <ProgressRing x:Name="SupportSending" Width="24" Height="24" Visibility="Collapsed" IsActive="True" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Grid>
                    <TextBlock Text="내 문의" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button x:Name="SupportRefreshButton" Content="답변 새로고침" HorizontalAlignment="Right" Click="SupportRefreshButton_Click" />
                </Grid>
                <TextBlock x:Name="SupportEmpty" Text="아직 보낸 문의가 없어요." Style="{StaticResource SecondaryText}" />
                <ListView x:Name="SupportTickets" ItemsSource="{x:Bind Tickets}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="SupportTickets_ItemClick" MaxHeight="240">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="services:SupportTicket">
                            <Grid Padding="10" ColumnSpacing="16" CornerRadius="8" Background="{x:Bind RowBackground, Mode=OneWay}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="4"><TextBlock Text="{x:Bind Subject}" Foreground="{x:Bind RowForeground, Mode=OneWay}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind Summary}" Foreground="{x:Bind RowForeground, Mode=OneWay}" FontSize="12" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{x:Bind StatusText, Mode=OneWay}" Foreground="{x:Bind StatusForeground, Mode=OneWay}" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <Border x:Name="SupportConversationPanel" Visibility="Collapsed" Padding="24" CornerRadius="16"
                        Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                    <StackPanel Spacing="16">
                        <TextBlock x:Name="SupportConversationTitle" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock x:Name="SupportConversation" TextWrapping="Wrap" IsTextSelectionEnabled="True" LineHeight="24" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <Grid x:Name="SchedulerPage" Visibility="Collapsed" Padding="8">
            <StackPanel x:Name="SchedulerLogin" Spacing="8" VerticalAlignment="Top">
                <TextBlock Text="API 키를 연결하면 등록한 캐릭터의 스케줄러를 볼 수 있어요." Style="{StaticResource SecondaryText}" TextWrapping="Wrap" />
                <Button Content="API 키 연결하기" Click="OpenKeyPageButton_Click" />
            </StackPanel>
            <Grid x:Name="SchedulerControls" Visibility="Collapsed" ColumnSpacing="8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="144" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <ListView x:Name="SchedulerAvatarList" ItemsSource="{x:Bind SchedulerAvatars}" Visibility="Collapsed" Grid.Row="0" Padding="0,2"
                              SelectionMode="None" IsItemClickEnabled="True" ItemClick="SchedulerAvatar_ItemClick"
                              CanDragItems="True" CanReorderItems="True" AllowDrop="True"
                              DragItemsStarting="SchedulerAvatar_DragItemsStarting" DragItemsCompleted="SchedulerAvatar_DragItemsCompleted"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollMode="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollMode="Enabled"
                              AutomationProperties.Name="등록한 스케줄러 캐릭터 · 드래그하여 순서 변경">
