<!-- MapleDay: native workbench with the reference send-button blue (#3A83F7). -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="PageBrush" Color="#F8F7F4" />
    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="StageBrush" Color="#F5F3EE" />
    <SolidColorBrush x:Key="InkBrush" Color="#272822" />
    <SolidColorBrush x:Key="MutedBrush" Color="#62645C" />
    <SolidColorBrush x:Key="LineBrush" Color="#E3E2DA" />
    <SolidColorBrush x:Key="AccentBrush" Color="#3A83F7" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#E8F0FE" />
    <SolidColorBrush x:Key="SchedulerSelectedBrush" Color="#ECECEC" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#225EBF" />
    <SolidColorBrush x:Key="ReadBrush" Color="#F0EFEC" />
    <SolidColorBrush x:Key="ReadTextBrush" Color="#70736E" />
    <SolidColorBrush x:Key="DangerTextBrush" Color="#C42B1C" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#FDE7E9" />
    <SolidColorBrush x:Key="DangerLineBrush" Color="#F1B3AD" />
    <SolidColorBrush x:Key="NegativeBrush" Color="#C45B26" />
    <SolidColorBrush x:Key="TransparentBrush" Color="Transparent" />
    <StaticResource x:Key="HyperlinkButtonForeground" ResourceKey="AccentTextBrush" />
    <StaticResource x:Key="HyperlinkButtonForegroundPointerOver" ResourceKey="AccentTextBrush" />
    <StaticResource x:Key="HyperlinkButtonForegroundPressed" ResourceKey="AccentTextBrush" />
    <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#777970" />
    <Color x:Key="SystemAccentColor">#3A83F7</Color>
    <Color x:Key="SystemAccentColorLight1">#3A83F7</Color>
    <Color x:Key="SystemAccentColorLight2">#3A83F7</Color>
    <Color x:Key="SystemAccentColorLight3">#3A83F7</Color>
    <Color x:Key="SystemAccentColorDark1">#3A83F7</Color>
    <Color x:Key="SystemAccentColorDark2">#3A83F7</Color>
    <Color x:Key="SystemAccentColorDark3">#3A83F7</Color>
    <FontFamily x:Key="AppFont">ms-appx:///Assets/Fonts/PretendardVariable.ttf#Pretendard Variable</FontFamily>
    <StaticResource x:Key="ContentControlThemeFontFamily" ResourceKey="AppFont" />
    <Style x:Key="SecondaryText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        <Setter Property="FontSize" Value="14" />
    </Style>
</ResourceDictionary>
